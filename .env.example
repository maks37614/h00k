# Application port (3000 by default; Docker Compose sets PORT=3000)
PORT=3000
APP_PORT=3000

# Environment: production or development
NODE_ENV=production

# Separate read-only data credential for the external PHP paper bot (32+ random characters).
# Empty disables /api/paper/formations. Never commit a real token.
HOOK_PAPER_FEED_TOKEN=
# Share the EXISTING 75-candidate background budget across all six TFs (12-13 each).
HOOK_SCREENER_TIMEFRAMES=1m,5m,15m,1h,4h,1d
# Legacy single-TF setting, used only when HOOK_SCREENER_TIMEFRAMES is absent.
HOOK_SCREENER_TIMEFRAME=1h

# PostgreSQL free registration (the only authentication backend).
# Mandatory: generate with: openssl rand -hex 32
# Keep ONLY in .env on VPS; do not commit actual credentials.
POSTGRES_PASSWORD=
PUBLIC_BASE_URL=https://h00k.top
# Assumes exactly one trusted reverse proxy (Nginx/Caddy) in front of localhost:3000.
# Set to 0 only if there is no trusted proxy. Never expose the app port publicly.
AUTH_TRUST_PROXY=1

# Cloudflare Turnstile CAPTCHA: mandatory for login, signup, verification resend and
# password reset email requests. Create a Managed widget for h00k.top in Cloudflare.
# Obtain keys at https://dash.cloudflare.com/ (Turnstile), not from OVH.
# Without both keys these four actions intentionally fail closed, but public
# screener/chart/replay and existing authenticated sessions stay unaffected.
# Never use Cloudflare's published testing site/secret keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email required for verification and password recovery.
# Use SMTP with STARTTLS (port 587) or TLS (port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CoinGecko Demo Holders: free (10,000 calls/month total for your API key).
# Create a free key: https://www.coingecko.com/en/api
# Keep the secret ONLY in .env on the VPS; never add to Vite/public env.
COINGECKO_DEMO_API_KEY=
# Strict monthly outbound ceiling, default 8,000 to preserve quota for other use.
# Central per-server cache holds results for 12h; metadata catalog for 24h.
COINGECKO_HOLDERS_MONTHLY_BUDGET=8000
# Optional exact overrides for ambiguous tickers/multiple chains, as one-line JSON.
# Use confirmed CoinGecko onchain network IDs and real contract addresses.
# e.g. {"TOKEN":{"network":"eth","address":"0x<40 hexadecimal characters>"}}
# No mapping is safer than guessing the wrong contract.
COINGECKO_HOLDERS_TOKEN_MAP={}

# Liq scalability pilot: 256 active Binance+Bybit instrument scopes using
# multiplexed upstream sockets (64 topics per socket). Legacy mode = 0.
LIQ_MULTIPLEX_ENABLED=1
LIQ_MARKET_CAP=256
# Browser connection safety guard; not a count of supported symbols.
LIQ_CLIENT_CAP=2000
# Optional PostgreSQL 8-day raw observed-event archive for 24h/7d map data.
# Disabled by default: enable ONLY after backing up PostgreSQL and measuring
# writes/retention on the VPS. Does not backfill gaps or capture inactive coins.
LIQ_ARCHIVE_ENABLED=0
# Optional second rollout (new frontend bundle): one WS per tab across
# Terminal charts instead of one WS per different market. Rebuild to change.
# Keep 0 until the VPS's pooled Liq rollout is verified.
VITE_LIQ_CLIENT_MULTIPLEX=0

# Gemini API Key (optional, for AI pattern analysis):
GEMINI_API_KEY=

# Shared H00K bot for Telegram notifications. Each user links their own Telegram chat in the app.
TELEGRAM_BOT_TOKEN=

# Optional read-only market-data metrics endpoint; requires a >=32-byte secret.
# Generate: openssl rand -hex 32; leave unset to disable /api/ops/market-data.
H00K_OPS_TOKEN=

# Emergency rollout switches: default ON; set to 0 and restart the app
# to restore prior behavior for the affected subsystem if staging finds a bug.
H00K_SHARED_STREAMS=1
H00K_ALERT_PRICE_WS=1
H00K_BINANCE_TICKER_WS=1
H00K_BYBIT_OI_WS=1

# Public quote wire optimization; default ON, each independently reversible.
H00K_QUOTE_CACHE=1
H00K_QUOTE_GZIP=1

# Live cross-user candle relay capacity on this small VPS (one upstream WS
# per exchange/symbol/timeframe, many browser viewers). When full,
# browsers automatically fall back to direct exchange WebSocket.
H00K_MAX_KLINE_CLIENTS=128
H00K_MAX_KLINE_MARKETS=48

# HookChart depth WS capacity, defaults remain identical to the original site.
# Increase only after a controlled load test on your own VPS.
H00K_MAX_DEPTH_CLIENTS=256
H00K_MAX_DEPTH_MARKETS=64
